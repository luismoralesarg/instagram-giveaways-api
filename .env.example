# Copiar a .env (en el mismo directorio que docker-compose.prod.yml) y completar antes de
# levantar el deploy. .env NO se commitea (ver .gitignore).

# Host "postgres" = el nombre del servicio de Postgres en docker-compose.prod.yml, resuelto
# por la red interna de Docker — no localhost.
DATABASE_URL=postgres://giveaways:CAMBIAR@postgres:5432/giveaways?sslmode=disable

# Contraseña del usuario de Postgres. Debe coincidir con la que quede en DATABASE_URL arriba.
POSTGRES_PASSWORD=CAMBIAR

JWT_SECRET=

# INSTAGRAM_APP_ID e INSTAGRAM_APP_SECRET identifican la app de Meta (ver ARCHITECTURE.md §3.1
# — se usan para refrescar el long-lived token, no es el token en sí, que vive en Postgres).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

PORT=8080
